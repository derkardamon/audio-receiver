#!/bin/bash

# Bluetooth Auto-Pair Script
# Automatically pairs and trusts devices without requiring user confirmation

# Function to send commands to bluetoothctl
bt_cmd() {
    echo -e "$1\nquit" | bluetoothctl
}

# Set up Bluetooth for auto-pairing
echo "Setting up Bluetooth auto-pairing..."

# Make adapter discoverable and pairable
bt_cmd "power on"
bt_cmd "discoverable on"
bt_cmd "pairable on"

# Start bt-agent in the background for auto-pairing
# NoInputNoOutput mode means no PIN/passkey required
bt-agent -c NoInputNoOutput &
BT_AGENT_PID=$!

echo "Bluetooth auto-pair agent running (PID: $BT_AGENT_PID)"
echo "Device is discoverable and will auto-pair without PIN"

# Monitor for new device connections
dbus-monitor --system "type='signal',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',path_namespace='/org/bluez'" 2>/dev/null |
while read -r line; do
    # Check for new device connections or pairing requests
    if echo "$line" | grep -q "org.bluez.Device1"; then
        # Give some time for the device path to appear
        sleep 0.5

        # Get all devices and auto-trust new ones
        bluetoothctl devices 2>/dev/null | while read -r _ mac _; do
            if [ -n "$mac" ]; then
                # Check if device is paired but not trusted
                info=$(bluetoothctl info "$mac" 2>/dev/null)
                if echo "$info" | grep -q "Paired: yes"; then
                    if ! echo "$info" | grep -q "Trusted: yes"; then
                        echo "Auto-trusting device: $mac"
                        bt_cmd "trust $mac"
                    fi
                fi
            fi
        done
    fi
done
