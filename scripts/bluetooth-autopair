#!/bin/bash

# Bluetooth Auto-Pair Script
# Automatically pairs and trusts devices without requiring user confirmation

# Enable Bluetooth agent with NoInputNoOutput capability (no pairing code required)
bluetoothctl << EOF
agent NoInputNoOutput
default-agent
discoverable on
pairable on
EOF

# Monitor for new Bluetooth devices and auto-pair/trust them
dbus-monitor --system "interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',path_namespace='/org/bluez/hci0'" |
while read -r line; do
    if echo "$line" | grep -q "Device"; then
        # Extract device path
        device_path=$(echo "$line" | grep -oP '/org/bluez/hci[0-9]+/dev_[A-F0-9_]+')

        if [ -n "$device_path" ]; then
            echo "New device detected: $device_path"

            # Wait a moment for device to be ready
            sleep 1

            # Trust and pair the device
            bluetoothctl << EOF
trust $device_path
pair $device_path
connect $device_path
EOF

            echo "Device paired and trusted: $device_path"
        fi
    fi
done
